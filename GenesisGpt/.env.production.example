# Production environment configuration example
# Copy this to .env.production and fill in your actual values

# Set environment
ENVIRONMENT=production

# Job API Configuration
PROD_JOB_API=https://api.yourplatform.com
JOB_API_TOKEN=your-job-api-token

# Datadog Configuration
PROD_TRACE_API=https://api.datadoghq.com
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Sandbox API Configuration
PROD_SANDBOX_API=https://sandbox.yourplatform.com
SANDBOX_API_TOKEN=your-sandbox-api-token

# Optional: Additional headers or authentication
# PROD_API_HEADERS={"Authorization": "Bearer token", "X-Custom-Header": "value"}